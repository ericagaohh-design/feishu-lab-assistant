{
  "id": "guv-imaging",
  "version": "0.1",
  "title": "GUV 成像记录",
  "fields": [
    {
      "id": "sample",
      "label": "样品、批次及对照分组",
      "aliases": [
        "样品",
        "样品编号",
        "批次",
        "批号",
        "分组",
        "对照"
      ],
      "hint": "逐一记录样品编号、批次与对照组。",
      "ask": "这次观察的是哪个样品或批次？"
    },
    {
      "id": "location",
      "label": "孔位、视野及取景范围",
      "aliases": [
        "孔位",
        "孔号",
        "视野",
        "视野数",
        "位置"
      ],
      "hint": "列出孔位、视野编号、取景范围和取样方式（如固定位置或随机视野）。",
      "ask": "这个样品拍的是哪个孔位或哪几个视野？"
    },
    {
      "id": "files",
      "label": "原始图像文件或路径",
      "aliases": [
        "原图",
        "原图文件",
        "原始图像",
        "原始文件",
        "文件名",
        "原始文件索引"
      ],
      "hint": "记原始文件名或位置，作为文件索引。",
      "ask": "这些视野的原图文件名或存放位置是什么？"
    },
    {
      "id": "linking",
      "label": "文件对应的样品及视野",
      "aliases": [
        "文件对应",
        "样品与文件",
        "视野与文件",
        "原图对应"
      ],
      "hint": "一个文件记一条对应关系；关系不清可以待补。",
      "ask": "这份原图对应哪个样品、孔位或视野？"
    },
    {
      "id": "acquisition",
      "label": "成像设置",
      "aliases": [
        "成像",
        "仪器",
        "设备",
        "通道",
        "物镜",
        "成像模式",
        "比例尺",
        "曝光",
        "增益"
      ],
      "hint": "按实际记模式、物镜、通道；有校准时可补比例尺或像素尺寸。",
      "ask": "实际用了哪种成像模式或物镜？"
    },
    {
      "id": "observation",
      "label": "观察、读数与计数口径",
      "aliases": [
        "观察",
        "现象",
        "结果",
        "测量",
        "读数",
        "计数",
        "统计分母"
      ],
      "hint": "保留原数值和单位。计数时写明每个视野、孔或样品的统计口径以及分母。",
      "ask": "在这些视野里实际看到了什么，或数到了多少？"
    },
    {
      "id": "date",
      "label": "实验日期与观察时间",
      "aliases": [
        "实验日期",
        "日期",
        "观察时间",
        "采集时间"
      ],
      "hint": "填写实际采集时间。"
    },
    {
      "id": "operator",
      "label": "实际操作者",
      "aliases": [
        "操作者",
        "操作人",
        "实验者"
      ],
      "hint": "按口述登记实际操作人员，与飞书账号分列。"
    },
    {
      "id": "purpose",
      "label": "目的与预期",
      "aliases": [
        "目的",
        "实验目的",
        "预期"
      ],
      "hint": "本次想回答的问题。"
    },
    {
      "id": "background",
      "label": "制样及测量背景（选填）",
      "aliases": [
        "内相",
        "外相",
        "各相",
        "组分",
        "样品来源",
        "制样背景",
        "溶剂",
        "渗透压",
        "制样日期"
      ],
      "hint": "需要解释照片时补记已知的组分、原单位和批号。"
    },
    {
      "id": "plan",
      "label": "计划",
      "aliases": [
        "计划",
        "准备",
        "拟做"
      ],
      "hint": "保留计划语气。"
    },
    {
      "id": "interpretation",
      "label": "解释或假设",
      "aliases": [
        "解释",
        "推测",
        "假设"
      ],
      "hint": "把可能的原因与观察分开。"
    },
    {
      "id": "correction",
      "label": "更正（对照先前原话）",
      "aliases": [
        "更正",
        "修正",
        "纠正"
      ],
      "hint": "记录原值、改后值及对应样品；历史口述保留。"
    },
    {
      "id": "pending",
      "label": "已说明的待补项",
      "aliases": [
        "待补",
        "待确认",
        "待查"
      ],
      "hint": "例如原图回工位再补。"
    }
  ]
}
